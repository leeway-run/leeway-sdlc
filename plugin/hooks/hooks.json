{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.mjs" },
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/leeway-guard.mjs" }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^leeway-sdlc:sdlc-(implementer|reviewer)$",
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/required-reading.mjs" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/version-notice.mjs" }
        ]
      }
    ]
  }
}
