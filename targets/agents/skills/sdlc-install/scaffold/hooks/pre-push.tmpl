#!/bin/sh
# The pre-push guard run requires (leeway-sdlc, sdlc-install question 16). It refuses a push to the integration branch
# and a force push to any ref, deciding from the refs git passes on stdin, so HEAD:<branch> from a detached HEAD is caught:
#   <local ref> <local oid> <remote ref> <remote oid>
# --no-verify and -c core.hooksPath skip it, so it stops the push an agent ordinarily writes, not a determined one.

integration='refs/heads/{{INTEGRATION_BRANCH}}'
refused=0

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "$integration" ]; then
    echo "pre-push guard: refused $local_ref -> $remote_ref: the integration branch is not pushed to." >&2
    refused=1
    continue
  fi
  # A delete has an all-zero local oid, and a new ref an all-zero remote one: neither overwrites history.
  case $local_oid in *[!0]*) ;; *) continue ;; esac
  case $remote_oid in *[!0]*) ;; *) continue ;; esac
  # Stdin doesn't carry --force. What it shows is an update that isn't a fast-forward, and git only lets one get this far
  # when it is forced. A remote commit this clone doesn't have fails the check too, so it is refused.
  if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    echo "pre-push guard: refused $local_ref -> $remote_ref: a force push, not a fast-forward of $remote_oid." >&2
    refused=1
  fi
done

exit $refused
